	langid = {english},
	keywords = {Combinatorial Problem, Finite Alphabet, Polynomial Time, Regular Expression, Turing Machine},
	file = {Full Text PDF:files/51/Karp - 1972 - Reducibility among Combinatorial Problems.pdf:application/pdf},
}

