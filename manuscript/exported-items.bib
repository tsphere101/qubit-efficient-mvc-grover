	keywords = {{NP}-complete problem, Search problems, vertex cover problem, Computers, Grover’s algorithm, Logic gates, Qubit, Dicke state, Consumer electronics, Quantum state},
	file = {Full Text PDF:files/31/Jiang and Lin - 2025 - Improving Grover’s Algorithm with Dicke States.pdf:application/pdf;Snapshot:files/25/11207978.html:text/html},
