@article{heidari_novel_2017,
	title = {A novel quantum {LSB}-based steganography method using the Gray code for colored quantum images},
	volume = {16},
	issn = {1573-1332},
	url = {https://doi.org/10.1007/s11128-017-1694-8},
	doi = {10.1007/s11128-017-1694-8},
	abstract = {As one of the prevalent data-hiding techniques, steganography is defined as the act of concealing secret information in a cover multimedia encompassing text, image, video and audio, imperceptibly, in order to perform interaction between the sender and the receiver in which nobody except the receiver can figure out the secret data. In this approach a quantum {LSB}-based steganography method utilizing the Gray code for quantum {RGB} images is investigated. This method uses the Gray code to accommodate two secret qubits in 3 {LSBs} of each pixel simultaneously according to reference tables. Experimental consequences which are analyzed in {MATLAB} environment, exhibit that the present schema shows good performance and also it is more secure and applicable than the previous one currently found in the literature.},
	pages = {242},
	number = {10},
	journaltitle = {Quantum Information Processing},
	shortjournal = {Quantum Inf Process},
	author = {Heidari, Shahrokh and Farzadnia, Ehsan},
	urldate = {2026-01-30},
	date = {2017-08-22},
	langid = {english},
	keywords = {{LSB}, Quantum image, Quantum steganography, {RGB}, The Gray code},
	file = {Full Text PDF:files/102/Heidari and Farzadnia - 2017 - A novel quantum LSB-based steganography method using the Gray code for colored quantum images.pdf:application/pdf},
}

@inproceedings{jiang_novel_2023,
	title = {Novel Quantum Circuit Designs for the Oracle of Grover’s Algorithm to Solve the Vertex Cover Problem},
	url = {https://ieeexplore.ieee.org/document/10383108/},
	doi = {10.1109/ECICE59523.2023.10383108},
	abstract = {We propose new quantum circuit designs for the Grover oracle, i.e., the oracle of Grover’s algorithm, to solve the vertex cover problem ({VCP}) efficiently. Grover’s algorithm is an unstructured quantum search algorithm to search a target data item out of N data pieces by calling the oracle {\textbackslash}{mathrmO}({\textbackslash}{sqrtN}) times. It represents a quadratic speedup compared to the classical unstructured data sequential search algorithm, which requires O(N) oracle calls. We are in the noisy intermediate-scale quantum ({NISQ}) era in which quantum computers have a limited number of qubits, short decoherence time, and low gate fidelity. It is thus desirable to design quantum circuits with three properties: (1) a reduced number of qubits, (2) shorter quantum depth, and (3) fewer gates. We created novel designs of a quantum counter and a quantum semaphore to be applied to the Grover oracle to have the three properties. Through the {IBM} Quantum Lab service, we executed Grover’s algorithm with the novel quantum circuit designs to solve the {VCP} to validate the design correctness.},
	eventtitle = {2023 {IEEE} 5th Eurasia Conference on {IOT}, Communication and Engineering ({ECICE})},
	pages = {652--657},
	booktitle = {2023 {IEEE} 5th Eurasia Conference on {IOT}, Communication and Engineering ({ECICE})},
	author = {Jiang, Jehn-Ruey and Yan, Wei-Han},
	urldate = {2026-01-30},
	date = {2023-10},
	keywords = {Quantum circuit, vertex cover problem, Computers, Grover’s algorithm, Logic gates, Noise measurement, oracle, quantum algorithm, quantum circuit, Qubit},
	file = {PDF:files/105/Jiang and Yan - 2023 - Novel Quantum Circuit Designs for the Oracle of Grover’s Algorithm to Solve the Vertex Cover Problem.pdf:application/pdf},
}

